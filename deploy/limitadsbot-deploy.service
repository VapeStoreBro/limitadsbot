[Unit]
Description=Limit Ads GitHub Deploy Webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/limitadsbot
EnvironmentFile=/root/limitadsbot/.env
ExecStart=/root/limitadsbot/.venv/bin/python deploy/github_webhook.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
