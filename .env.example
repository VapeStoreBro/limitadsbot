# Telegram
BOT_TOKEN=replace_me
OWNER_ID=6577441312
BAZAAR_CHAT_ID=-1003377593526
BAZAAR_URL=https://t.me/bgghtrhrwbehtvrw
STAFF_CHAT_ID=-1003791561734
TIMEZONE=Europe/Moscow

# PostgreSQL in production. Keep POSTGRES_PASSWORD and DATABASE_URL synchronized.
POSTGRES_PASSWORD=replace_with_hex_password
DATABASE_URL=postgresql+asyncpg://limitads:replace_with_hex_password@127.0.0.1:5433/limitads

# During the first test leave this empty: the bot will use long polling.
# Later a valid HTTPS domain can be added for Telegram webhook mode.
WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/change_me_path
TELEGRAM_WEBHOOK_SECRET=change_me_header_secret
WEB_SERVER_HOST=127.0.0.1
WEB_SERVER_PORT=8092

# Real payments remain disabled until the test-payment flow is accepted.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=test

# First prepared provider: YooKassa. Fill these only before integration testing.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.com/payments/return
YOOKASSA_WEBHOOK_PATH=/payments/yookassa/webhook

# Standalone GitHub deploy webhook receiver for this repository.
GITHUB_REPOSITORY=VapeStoreBro/limitadsbot
GITHUB_WEBHOOK_SECRET=change_me_github_secret
DEPLOY_PATH_SECRET=change_me_deploy_path
DEPLOY_HOST=0.0.0.0
DEPLOY_PORT=9102
PROJECT_DIR=/root/limitadsbot
SYSTEMD_SERVICE=limitadsbot.service
