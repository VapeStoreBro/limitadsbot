# Telegram
BOT_TOKEN=replace_me
OWNER_ID=6577441312
BAZAAR_CHAT_ID=-1003377593526
STAFF_CHAT_ID=-5466156820
TIMEZONE=Europe/Moscow

# PostgreSQL in production. SQLite is acceptable only for local development.
DATABASE_URL=postgresql+asyncpg://limitads:change_me@127.0.0.1:5433/limitads

# Telegram webhook. Leave WEBHOOK_BASE_URL empty for local polling.
WEBHOOK_BASE_URL=https://bot.example.com
TELEGRAM_WEBHOOK_PATH=/telegram/change_me_path
TELEGRAM_WEBHOOK_SECRET=change_me_header_secret
WEB_SERVER_HOST=127.0.0.1
WEB_SERVER_PORT=8092

# GitHub deploy webhook receiver
GITHUB_REPOSITORY=VapeStoreBro/limitadsbot
GITHUB_WEBHOOK_SECRET=change_me_github_secret
DEPLOY_PATH_SECRET=change_me_deploy_path
DEPLOY_HOST=127.0.0.1
DEPLOY_PORT=9102
PROJECT_DIR=/opt/limitadsbot
SYSTEMD_SERVICE=limitadsbot.service
